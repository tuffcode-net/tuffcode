{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@tuffcode/shared": ["./packages/shared/src/index.ts"],
      "@tuffcode/contracts": ["./packages/contracts/src/index.ts"],
      "@tuffcode/server": ["./packages/server/src/index.ts"],
      "@tuffcode/adapters": ["./packages/adapters/src/index.ts"],
      "@tuffcode/adapters/*": ["./packages/adapters/src/*/index.ts"],
      "@tuffcode/ui": ["./packages/ui/src/index.ts"],
      "@tuffcode/prompt": ["./packages/prompt/src/index.ts"]
    }
  }
}
